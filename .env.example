# Copy to .env (gitignored) and fill in. The server's run and test tasks read it;
# real environment variables win over it.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: port for the local server (default 8080).
# PORT=8080

# Optional model overrides per role (GEN = decks, TURN = lesson rounds, GRADER = evals):
# GEN_MODEL=gemini-3.6-flash
# TURN_MODEL=gemini-3.5-flash-lite
# GRADER_MODEL=gemini-3.6-flash
# Each role also takes _THINKING (e.g. LOW), _MAX_TOKENS and _TEMPERATURE.
